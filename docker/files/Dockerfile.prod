FROM node:22.14-bullseye-slim
WORKDIR /home/api/nestjs/saas-and-ecommerce-boilerplate-nestjs

# Keep in sync with "packageManager" in package.json
RUN npm install -g pnpm@10.34.6

# Dev dependencies are needed to build (nest cli, typescript, swc); they are pruned below
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

RUN pnpm exec prisma generate

RUN pnpm run build
RUN rm -rf src test
RUN pnpm prune --prod

EXPOSE ${PORT_API}

CMD ["sh", "-c", "pnpm exec prisma migrate deploy && pnpm run start:prod"]
